  },
  "homepage": "https://github.com/create-new-entity/bookden#readme",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ramda": "^0.31.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.38.0",
