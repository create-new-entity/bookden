{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "tsc": "tsc",
    "build": "cross-env NODE_ENV=production tsc",
    "lint": "eslint",
    "pre:migrate:up:test": "cross-env DB_NAME=bookden_test  NODE_ENV=test tsx ./scripts/pre-migrate.ts",
    "pre:migrate:up:dev": "cross-env NODE_ENV=development tsx ./scripts/pre-migrate.ts",
    "migrate:up:test": "npm run pre:migrate:up:test && cross-env DB_NAME=bookden_test  NODE_ENV=test ./node_modules/.bin/db-migrate up",
    "migrate:up:dev": "npm run pre:migrate:up:dev && cross-env NODE_ENV=development ./node_modules/.bin/db-migrate up",
    "migrate:up:prod": "cross-env NODE_ENV=production ./node_modules/.bin/db-migrate up",
    "dev": "npm run migrate:up:dev && cross-env NODE_ENV=development tsx watch index.ts",
    "test": "npm run migrate:up:test && cross-env DB_NAME=bookden_test  NODE_ENV=test jest --runInBand",
    "test:bail": "npm run migrate:up:test && cross-env DB_NAME=bookden_test  NODE_ENV=test jest --runInBand --bail"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/create-new-entity/bookden.git"
  },
