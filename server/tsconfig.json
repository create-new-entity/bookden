{
  "compilerOptions": {
    "target": "ES2020",
    "outDir": "./build",
    "module": "ES2020",   
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": true,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmitOnError": true
  }
}
