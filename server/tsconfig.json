{
  "compilerOptions":{
    "target": "ES2020",
    "outDir": "./build/",
    "module": "node16",
    "moduleResolution": "node16",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "allowUnreachableCode": false,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "esModuleInterop": true
  }
}